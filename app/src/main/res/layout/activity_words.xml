<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/words_bg">

    <!-- MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Learn Words"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:gravity="center"
            android:padding="12dp" />

        <!-- WORD -->
        <TextView
            android:id="@+id/tvWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cat"
            android:textSize="72sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:gravity="center"
            android:layout_marginTop="40dp" />

        <!-- IMAGE (OPTIONAL IF YOU ADD LATER) -->
        <ImageView
            android:id="@+id/imgWord"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:scaleType="fitCenter"
             />

        <!-- SPEAK BUTTON -->
        <Button
            android:id="@+id/btnSpeak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊 Speak"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#6A1B9A"
            android:textColor="#FFFFFF" />

        <!-- NAVIGATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⬅ Prev" />

            <View
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Next ➡" />
        </LinearLayout>

    </LinearLayout>

    <!-- 🎉 PARTY / FIRECRACKER OVERLAY -->
    <!-- You can hide/show this from Java later -->
    <TextView
        android:id="@+id/tvCelebrate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="🎉🎉🎉\nGreat Job!\n🎉🎉🎉"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FF6F00"
        android:gravity="center"
        android:background="#80FFFFFF"
        android:visibility="gone" />

</FrameLayout>
