<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3E1FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:id="@+id/tvNumbersVideoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Numbers Video"
            android:textColor="#5A189A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/videoContainerNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/video_card_bg"
            android:elevation="8dp"
            android:clickable="false"
            android:focusable="false">

            <VideoView
                android:id="@+id/videoViewNumbers"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:focusable="false"
                android:clickable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNumbersDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn numbers with fun visuals and sound."
            android:textColor="#120209"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false">

            <Button
                android:id="@+id/btnPlayNumbersVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Play"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6A1B9A"
                android:clickable="true"
                android:focusable="true" />

            <Button
                android:id="@+id/btnBackNumbers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EF6C00"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:padding="18dp"
            android:background="@drawable/dialog_emotion_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Awesome counting 🌟"
                android:textColor="#FFD600"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Watching number videos daily can improve counting, recognition and pronunciation."
                android:textColor="#00C853"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgNumbersMascot"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:src="@drawable/mascot_bg"
            android:contentDescription="Mascot"
            android:scaleType="fitCenter" />

    </LinearLayout>
</ScrollView>