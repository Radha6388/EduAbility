<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ai_sky">

    <!-- 🧠 TITLE -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buddy AI 🦉"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#0F0D0D"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 🦉 OWL IMAGE (CENTER) -->
    <ImageView
        android:id="@+id/imgOwl"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:src="@drawable/owl"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintBottom_toTopOf="@id/txtBubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 💬 SPEECH BUBBLE -->
    <TextView
        android:id="@+id/txtBubble"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_speech_bubble"
        android:elevation="4dp"
        android:padding="16dp"
        android:text="    Hi 😊 I'm Buddy! Tap mic 🎤 and talk to me!"
        android:textColor="#333"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btnMic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgOwl" />

    <!-- 🎤 MIC BUTTON (BOTTOM CENTER) -->
    <ImageView
        android:id="@+id/btnMic"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="32dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:background="@drawable/bg_mic_circle"
        android:padding="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>