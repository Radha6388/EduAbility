<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#A7BF97"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header -->
    <TextView
        android:text="🎮 Fun Games"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="#120A09"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="Play and Enjoy 😊"
        android:textSize="26sp"
        android:textColor="#AA00FF"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Grid -->
    <GridLayout
        android:columnCount="2"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Balloon Game -->
        <LinearLayout
            android:id="@+id/cardBalloon"
            android:orientation="vertical"
            android:background="@drawable/game_card_bg"
            android:elevation="6dp"
            android:padding="16dp"
            android:layout_margin="10dp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/balloon"
                android:layout_width="100dp"
                android:layout_height="100dp"/>

            <TextView
                android:text="Tic Tac Toe 🎈"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- Memory Game -->
        <LinearLayout
            android:id="@+id/cardMemory"
            android:orientation="vertical"
            android:background="@drawable/game_card_bg"
            android:elevation="6dp"
            android:padding="16dp"
            android:layout_margin="10dp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/memory"
                android:layout_width="90dp"
                android:layout_height="90dp"/>

            <TextView
                android:text="Memory Match 🧩"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- Color Game -->
        <LinearLayout
            android:id="@+id/cardBaseball"
            android:orientation="vertical"
            android:background="@drawable/game_card_bg"
            android:elevation="6dp"
            android:padding="16dp"
            android:layout_margin="10dp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/_772596_60161"
                android:layout_width="100dp"
                android:layout_height="100dp"/>

            <TextView
                android:text="Base ball"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- Catch Game -->
        <LinearLayout
            android:id="@+id/cardCatch"
            android:orientation="vertical"
            android:background="@drawable/game_card_bg"
            android:elevation="6dp"
            android:padding="16dp"
            android:layout_margin="10dp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/catch_games"
                android:layout_width="100dp"
                android:layout_height="100dp"/>

            <TextView
                android:text="Catch Game 🐱"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333"
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>


    </GridLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:background="#fbff8e">

        <TextView
            android:text="🎉 Keep Playing &amp; Have Fun!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FF6F61"
            android:gravity="center"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Play more games and enjoy your learning journey 😊"
            android:textSize="16sp"
            android:textColor="#555"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</LinearLayout>