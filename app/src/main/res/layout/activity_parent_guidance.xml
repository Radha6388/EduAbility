<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD600">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👨‍👩‍👧 Parent Guidance"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <!-- CARD 1 -->
        <Button
            android:id="@+id/btnHowToUse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📘 How to Use EduAbility"
            android:textSize="16sp"
            android:backgroundTint="#BBDEFB"
            android:textColor="#0D47A1"
            android:layout_marginBottom="8dp" />

        <!-- CARD 2 -->
        <Button
            android:id="@+id/btnRoutine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️ Daily Learning Routine"
            android:textSize="16sp"
            android:backgroundTint="#C8E6C9"
            android:textColor="#1B5E20"
            android:layout_marginBottom="8dp" />

        <!-- CARD 3 -->
        <Button
            android:id="@+id/btnTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧠 Learning Tips"
            android:textSize="16sp"
            android:backgroundTint="#FFF9C4"
            android:textColor="#F57F17"
            android:layout_marginBottom="8dp" />

        <!-- CARD 4 -->
        <Button
            android:id="@+id/btnProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Understanding Child Progress"
            android:textSize="16sp"
            android:backgroundTint="#E1BEE7"
            android:textColor="#4A148C"
            android:layout_marginBottom="8dp" />

        <!-- CARD 5 -->
        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤝 When to Seek Help"
            android:textSize="16sp"
            android:backgroundTint="#FFCDD2"
            android:textColor="#B71C1C"
            android:layout_marginBottom="12dp" />

        <!-- CONTENT AREA -->
        <TextView
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a topic to read guidance."
            android:textSize="15sp"
            android:textColor="#37474F"
            android:padding="12dp"
            android:background="#FFFFFF" />

    </LinearLayout>
</ScrollView>
