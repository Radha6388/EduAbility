<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090909"
    android:padding="16dp">

    <TextView
        android:text="👩‍⚕️ Therapist Activities"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#DD2C00"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Focus -->
    <Button
        android:id="@+id/btnFocus"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="🎯 Focus Activities"
        android:textSize="18sp"
        android:backgroundTint="#FFAB00"
        android:textColor="#000000"
        android:layout_marginBottom="12dp"/>

    <!-- Emotion -->
    <Button
        android:id="@+id/btnEmotion"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="😊 Emotion Regulation"
        android:textSize="18sp"
        android:backgroundTint="#4FC3F7"
        android:textColor="#000000"
        android:layout_marginBottom="12dp"/>

    <!-- Motor -->
    <Button
        android:id="@+id/btnMotor"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="✋ Motor Skills"
        android:textSize="18sp"
        android:backgroundTint="#059742"
        android:textColor="#000000"/>
</LinearLayout>
