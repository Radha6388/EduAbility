<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0E0F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <TextView
            android:id="@+id/tvShapesVideoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Shapes Video"
            android:textColor="#E90404"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/videoContainerShapes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/dialog_emotion_bg"
            android:elevation="8dp"
            android:clickable="false"
            android:focusable="false">

            <VideoView
                android:id="@+id/videoViewShapes"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:focusable="false"
                android:clickable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvShapesDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn shapes with fun visuals and sound."
            android:textColor="#120209"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:clickable="false"
            android:focusable="false">

            <Button
                android:id="@+id/btnPlayShapesVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Play"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#0B0B0B"
                android:backgroundTint="#C51162"
                android:clickable="true"
                android:focusable="true" />

            <Button
                android:id="@+id/btnBackShapes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#0F0D0D"
                android:backgroundTint="#EF6C00"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:padding="18dp"
            android:background="@drawable/video_card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wonderful learning 🔷"
                android:textColor="#0A0B0A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Watching shapes videos daily helps children identify and remember shapes easily."
                android:textColor="#DD2C00"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgShapesMascot"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="50dp"
            android:src="@drawable/mascot_bg"
            android:contentDescription="Mascot"
            android:scaleType="fitCenter" />
        <!-- 🔺 SHAPES QUIZ SECTION -->
        <LinearLayout
            android:id="@+id/quizSectionShapes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="30dp"
            android:padding="18dp"
            android:background="#B14D02"
            android:elevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fun Shapes Quiz"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <!-- Q1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Which shape is round?"
                android:layout_marginTop="12dp"/>

            <RadioGroup
                android:id="@+id/q1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/q1a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Circle"/>

                <RadioButton android:id="@+id/q1b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Square"/>

                <RadioButton android:id="@+id/q1c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triangle"/>
            </RadioGroup>

            <!-- Q2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Which shape has 3 sides?"
                android:layout_marginTop="12dp"/>

            <RadioGroup
                android:id="@+id/q2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/q2a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triangle"/>

                <RadioButton android:id="@+id/q2b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Circle"/>

                <RadioButton android:id="@+id/q2c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rectangle"/>
            </RadioGroup>

            <!-- Q3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Which shape has 4 equal sides?"
                android:layout_marginTop="12dp"/>

            <RadioGroup
                android:id="@+id/q3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/q3a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Square"/>

                <RadioButton android:id="@+id/q3b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triangle"/>

                <RadioButton android:id="@+id/q3c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Circle"/>
            </RadioGroup>

            <!-- Q4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Which shape looks like a box?"
                android:layout_marginTop="12dp"/>

            <RadioGroup
                android:id="@+id/q4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/q4a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rectangle"/>

                <RadioButton android:id="@+id/q4b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Circle"/>

                <RadioButton android:id="@+id/q4c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triangle"/>
            </RadioGroup>

            <!-- Q5 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Which shape has no corners?"
                android:layout_marginTop="12dp"/>

            <RadioGroup
                android:id="@+id/q5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/q5a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Circle"/>

                <RadioButton android:id="@+id/q5b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Square"/>

                <RadioButton android:id="@+id/q5c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triangle"/>
            </RadioGroup>

            <!-- Submit -->
            <Button
                android:id="@+id/btnSubmitQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Answers"
                android:layout_marginTop="16dp"
                android:backgroundTint="#43A047"
                android:textColor="#FFFFFF"/>

            <!-- Result -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>