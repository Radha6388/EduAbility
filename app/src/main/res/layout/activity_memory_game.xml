<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#93C1C8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- HEADER -->
    <TextView
        android:text="🧠 Memory Match"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- STATS PANEL -->
    <LinearLayout
        android:orientation="horizontal"
        android:weightSum="3"
        android:background="#00C853"
        android:elevation="4dp"
        android:padding="12dp"
        android:layout_marginBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/movesText"
            android:text="Moves: 0"
            android:layout_weight="1"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/scoreText"
            android:text="Score: 0"
            android:layout_weight="1"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/timerText"
            android:text="Time: 0s"
            android:layout_weight="1"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- GAME GRID -->
    <GridLayout
        android:id="@+id/gameGrid"
        android:columnCount="3"
        android:rowCount="2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:useDefaultMargins="true"
        android:alignmentMode="alignMargins">

        <!-- Cards -->
        <Button android:id="@+id/card0" style="@style/cardStyle"/>
        <Button android:id="@+id/card1" style="@style/cardStyle"/>
        <Button android:id="@+id/card2" style="@style/cardStyle"/>
        <Button android:id="@+id/card3" style="@style/cardStyle"/>
        <Button android:id="@+id/card4" style="@style/cardStyle"/>
        <Button android:id="@+id/card5" style="@style/cardStyle"/>

    </GridLayout>

    <!-- STATUS -->
    <TextView
        android:id="@+id/statusText"
        android:text="Match all cards 🧠"
        android:textSize="18sp"
        android:textColor="#0D0303"
        android:layout_gravity="center"
        android:layout_marginTop="25dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- BUTTONS -->
    <Button
        android:text="Restart 🔄"
        android:onClick="restartGame"
        android:backgroundTint="#FFAB00"
        android:textColor="#100202"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>