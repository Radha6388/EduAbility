<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B0B"
    android:padding="20dp"
    android:gravity="center">

    <!-- 🌈 TITLE -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌿 Calm Time"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="#06B3BA"
        android:layout_marginBottom="12dp" />

    <!-- 😊 MESSAGE -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Let's calm our mind together"
        android:textSize="26sp"
        android:textColor="#0AEBC5"
        android:layout_marginBottom="24dp" />

    <!-- 🫁 BREATH CIRCLE -->
    <TextView
        android:id="@+id/tvBreath"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:gravity="center"
        android:text="INHALE"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FBF9F9"
        android:background="#4DB6AC" />

    <!-- 🧘 INSTRUCTION -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Breathe slowly"
        android:textSize="26sp"
        android:textColor="#03EDD0"
        android:layout_marginTop="20dp" />

    <!-- ▶ START BUTTON -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Breathing"
        android:textSize="18sp"
        android:textColor="#090000"
        android:backgroundTint="#00796B"
        android:layout_marginTop="30dp" />

</LinearLayout>
