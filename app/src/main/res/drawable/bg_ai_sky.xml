<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🌈 Gradient Base -->
    <item>
        <shape>
            <gradient
                android:startColor="#89163C"
                android:endColor="#A988BA"
                android:angle="40"/>
        </shape>
    </item>

    <!-- ☁️ Cloud 1 -->
    <item android:gravity="top|start">
        <bitmap
            android:src="@drawable/cloud1"
            android:alpha="0.4"
            android:gravity="center"/>
    </item>

    <!-- ☁️ Cloud 2 -->
    <item android:gravity="top|end">
        <bitmap
            android:src="@drawable/cloud2"
            android:alpha="0.4"
            android:gravity="center"/>
    </item>

    <!-- ⭐ Stars -->
    <item android:gravity="center">
        <bitmap
            android:src="@drawable/stars1"
            android:alpha="0.2"
            android:gravity="center"/>
    </item>

</layer-list>