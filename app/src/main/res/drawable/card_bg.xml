<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Card background color -->
    <solid android:color="#01606F"/>

    <!-- Rounded corners -->
    <corners android:radius="20dp"/>

    <!-- Soft border -->
    <stroke
        android:width="1dp"
        android:color="#E6E6E6"/>

    <!-- Inner padding -->
    <padding
        android:left="14dp"
        android:right="14dp"
        android:top="14dp"
        android:bottom="14dp"/>

</shape>